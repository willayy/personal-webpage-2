---
import Layout from '@/layouts/Layout.astro';
import List from '@/components/List.astro';
import EmploymentListItem from '@/components/EmploymentListItem.astro';
import { translateByKey, extractDataByKey } from '@/utils/localization';

interface EmploymentItem {
  id: number;
  position: string;
  organization: string;
  startDate: string;
  endDate: string;
  description: string;
}

const pageTitle = translateByKey('en', 'career.title', null);
const employmentList = extractDataByKey<EmploymentItem[]>('en', 'career.items');
---

<Layout title={`${pageTitle} - William Norland`}>
  <main>
    <div class="listBox roboto-regular">
      <h1>{pageTitle}</h1>

      <List>
        {employmentList.map((item) => (
          <EmploymentListItem
            position={item.position}
            organization={item.organization}
            startDate={item.startDate}
            endDate={item.endDate}
            description={item.description}
          />
        ))}
      </List>
    </div>
  </main>
</Layout>
