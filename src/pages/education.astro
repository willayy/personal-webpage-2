---
import Layout from '@/layouts/Layout.astro';
import List from '@/components/List.astro';
import EducationListItem from '@/components/EducationListItem.astro';
import educationDataRaw from '@/data/education.json';
import { translateByKey } from '@/utils/localization';

interface EducationItem {
  id: number;
  school: string;
  degree: string;
  graduation: string;
}

const educationList: EducationItem[] = educationDataRaw;
const pageTitle = translateByKey('en', 'education.title', null);
---

<Layout title={`${pageTitle} - William Norland`}>
  <main>
    <div class="listBox roboto-regular">
      <h1>{pageTitle}</h1>

      <List>
        {educationList.map((item) => (
          <EducationListItem
            school={item.school}
            degree={item.degree}
            graduation={item.graduation}
          />
        ))}
      </List>
    </div>
  </main>
</Layout>
