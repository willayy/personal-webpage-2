---
import { translateByKey } from '@/utils/localization';

interface Props {
  position: string;
  organization: string;
  startDate: string;
  endDate: string;
  description: string;
}

const { position, organization, startDate, endDate, description } = Astro.props;
const fromToLabel = translateByKey('en', 'career.fromTo', null);
---

<li class="listItem">
  <h2>{position}</h2>
  <p class="organization">{organization}</p>
  <p class="text">{description}</p>
  <p><strong>{fromToLabel}</strong> {startDate} - {endDate}</p>
</li>

<style>
  .organization {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-primary);
    margin: 5px 0;
  }

  .text {
    white-space: pre-line;
    line-height: 1.6;
    margin: 10px 0;
  }
</style>
